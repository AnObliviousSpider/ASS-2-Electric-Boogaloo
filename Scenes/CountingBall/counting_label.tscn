[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;

uniform vec2 focus = vec2(0.5, 0.5);
uniform float darkness : hint_range(0.0, 1.0) = 0.0;
uniform float clear_radius : hint_range(0.0, 0.5) = 0.10;
uniform float edge_radius : hint_range(0.1, 1.0) = 0.62;

void fragment() {
	float distance_from_focus = distance(UV, focus);
	float edge_mask = smoothstep(
		clear_radius,
		edge_radius,
		distance_from_focus
	);

	COLOR = vec4(
		0.0,
		0.0,
		0.0,
		edge_mask * darkness
	);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
